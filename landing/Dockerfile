FROM node:20-slim AS build
WORKDIR /app
ARG VITE_LK_URL
ARG VITE_BOT_URL
ARG VITE_LEGAL_OPERATOR_NAME
ARG VITE_LEGAL_OPERATOR_INN
ARG VITE_LEGAL_OPERATOR_OGRN
ARG VITE_LEGAL_OPERATOR_ADDRESS
ARG VITE_LEGAL_OPERATOR_EMAIL
ARG VITE_LEGAL_EFFECTIVE_DATE
ENV VITE_LK_URL=$VITE_LK_URL
ENV VITE_BOT_URL=$VITE_BOT_URL
ENV VITE_LEGAL_OPERATOR_NAME=$VITE_LEGAL_OPERATOR_NAME
ENV VITE_LEGAL_OPERATOR_INN=$VITE_LEGAL_OPERATOR_INN
ENV VITE_LEGAL_OPERATOR_OGRN=$VITE_LEGAL_OPERATOR_OGRN
ENV VITE_LEGAL_OPERATOR_ADDRESS=$VITE_LEGAL_OPERATOR_ADDRESS
ENV VITE_LEGAL_OPERATOR_EMAIL=$VITE_LEGAL_OPERATOR_EMAIL
ENV VITE_LEGAL_EFFECTIVE_DATE=$VITE_LEGAL_EFFECTIVE_DATE
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
