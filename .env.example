# Пример настроек. Для локального запуска файл не обязателен — значения по
# умолчанию заданы в compose.yaml. Скопируйте в .env, чтобы переопределить.
# Не храните реальные токены и пароли в репозитории: .env в .gitignore.

# dev — локальная разработка; prod — проверка обязательных секретов при старте.
ENV=dev
# Вход студента в браузере без MAX под тестовым id dev-*/demo-* (для проверки).
SANDBOX_LOGIN=true
# Демо-вузы, компании, студенты и стажировки (только записи demo-*).
ENABLE_DEMO_DATA=true

# PostgreSQL (сервис db, наружу не публикуется).
POSTGRES_DB=praktikaplus
POSTGRES_USER=praktikaplus
POSTGRES_PASSWORD=change-me

# Подпись JWT сервиса: в prod — не короче 32 случайных символов.
JWT_SECRET=change-me-to-a-long-random-string

# Бот MAX. Пусто -> режим мока: исходящие сообщения только пишутся в лог.
MAX_BOT_TOKEN=
# Секрет вебхука (5–256 символов: латиница, цифры, _ и -). MAX передаёт его в
# заголовке X-Max-Bot-Api-Secret; укажите тот же при регистрации вебхука.
MAX_WEBHOOK_SECRET=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_USERNAME=t417_hakaton_max_bot
MATCH_THRESHOLD=60
# Окно отмены решения работодателя (секунды) до отправки сообщения студенту.
DECISION_GRACE_SECONDS=90

# Публичные адреса (для прода — HTTPS-домены).
APP_BASE_URL=http://localhost:8001
API_PUBLIC_URL=http://localhost:8001
MAX_MINIAPP_URL=http://localhost:8003
LK_PUBLIC_URL=http://localhost:8002
LEGAL_BASE_URL=http://localhost:8004
BOT_PUBLIC_URL=https://max.ru/t417_hakaton_max_bot?startapp=app
MAX_BOT_LINK_BASE=https://max.ru/t417_hakaton_max_bot
CORS_ORIGINS=http://localhost:8002,http://localhost:8003,http://localhost:8004

# Реквизиты оператора персональных данных для правовых документов сайта.
# Пусто -> демонстрационные реквизиты вымышленной компании хакатона с пометкой.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
LEGAL_OPERATOR_OGRN=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
LEGAL_EFFECTIVE_DATE=

TERMS_VERSION=2026-09-23
PRIVACY_VERSION=2026-09-23
